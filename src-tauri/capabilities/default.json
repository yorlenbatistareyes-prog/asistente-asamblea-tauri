{
  "$schema": "../gen/schemas/desktop-capability.json",
  "identifier": "default",
  "description": "Permisos completos para gestión de archivos e impresión de cartas",
  "windows": [
    "*"
  ],
  "permissions": [
    "core:default",
    "sincronizacion-nativo:allow-pickSyncFile",
    "sincronizacion-nativo:allow-createSyncFile",
    "sincronizacion-nativo:allow-readSyncFile",
    "sincronizacion-nativo:allow-writeSyncFile",
    "sincronizacion-nativo:allow-saveSyncKey",
    "sincronizacion-nativo:allow-getSyncKey",
    "shell:default",
    "opener:default",
    "opener:allow-open-path",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "whatsapp://*"
        },
        {
          "url": "https://wa.me/*"
        },
        {
          "url": "https://updates.ejvapps.online/*"
        }
      ]
    },
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "process:default",
    "store:default",
    "core:window:allow-create",
    "core:webview:allow-create-webview-window",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-set-always-on-top",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        {
          "url": "https://syncserver.ejvapps.online/*"
        },
        {
          "url": "https://updates.ejvapps.online/*"
        }
      ]
    },
    "os:default"
  ]
}