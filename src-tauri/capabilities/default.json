{
  "$schema": "../gen/schemas/desktop-capability.json",
  "identifier": "default",
  "description": "Permisos completos para gestión de archivos e impresión de cartas",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:default",
    "opener:default",
    "opener:allow-open-path",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:allow-read-dir",
    "fs:allow-copy-file",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "fs:scope",
      "allow": [
        "**"
      ]
    },
    "process:default"
  ]
}